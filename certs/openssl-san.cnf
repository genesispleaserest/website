[req]
default_bits = 2048
prompt = no
default_md = sha256
req_extensions = req_ext
distinguished_name = dn

[dn]
# For local testing, set CN to your LAN IP or hostname
CN = 10.206.48.99

[req_ext]
subjectAltName = @alt_names

[alt_names]
# Replace with your machine's LAN IP
IP.1 = 10.206.48.99
# Optionally, add a hostname entry if you use one
# DNS.1 = mysite.local
